{
  "include": ["src", ".railway/railway.ts", "*.config.ts"],
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./src/*"] },
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "plugins": [
      {
        "name": "gql.tada/ts-plugin",
        "schema": "./src/server/schema.graphql",
        "tadaOutputLocation": "./src/server/graphql-env.d.ts"
      }
    ]
  }
}
