# Project token of the sandbox project (Project Settings > Tokens), sent as Project-Access-Token.
RAILWAY_API_TOKEN=
# Passcode for the login screen.
ACCESS_CODE=
# Signs the session cookie: at least 32 characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# Where instances live: a project of their own (Sandboxes on Railway), since the dashboard
# lists every service in it and can destroy any of them.
SANDBOX_PROJECT_ID=
SANDBOX_ENVIRONMENT_ID=
# Instance slots. The trial plan fits 4 services per project.
SANDBOX_MAX_SERVICES=4
