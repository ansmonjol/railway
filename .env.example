# Project token of the sandbox project (Project Settings > Tokens), sent as Project-Access-Token.
RAILWAY_API_TOKEN=
# Passcode for the login screen.
ACCESS_CODE=
# Signs the session cookie: at least 32 characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# Where instances live. On Railway, .railway/railway.ts points them at the dashboard's own project.
SANDBOX_PROJECT_ID=
SANDBOX_ENVIRONMENT_ID=
# Instance slots. The trial plan fits 4 services per project and the dashboard takes one.
SANDBOX_MAX_SERVICES=3
# Injected by Railway. Set it locally to hide the dashboard's own service from the list.
RAILWAY_SERVICE_ID=
